# Where the Vite dev server forwards /api requests (the ConfertecApi)
VITE_API_PROXY_TARGET=http://localhost:3000


# Production build only: the API's address when it's on another domain (e.g. https://api.temec.easify.net.br, whose nginx maps / to the API's /api/).
# Unset, the Front calls /api on its own domain (the Vite proxy in development)
VITE_API_BASE_URL=
